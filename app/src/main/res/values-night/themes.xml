<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@android:color/system_accent1_200</item>
        <item name="android:colorPrimary">@android:color/system_accent1_200</item>
        <item name="android:colorControlActivated">@android:color/system_accent1_200</item>
        <item name="android:windowBackground">@android:color/system_neutral1_900</item>
        <item name="android:textColorPrimary">@android:color/system_neutral1_100</item>
        <item name="android:textColorSecondary">@android:color/system_neutral2_200</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:buttonStyle">@style/AppButton</item>
    </style>
    <style name="AppButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?android:textColorPrimaryInverse</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
</resources>
